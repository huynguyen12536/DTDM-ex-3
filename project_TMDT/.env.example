# Project Environment Variables Template
# Copy this file to .env and fill in the values

PORT=5000
MONGODB_URL=mongodb://mongo:27017/lebaba_ecommerce
JWT_SECRET_KEY=your_jwt_secret_here
STRIPE_SECRET_KEY=your_stripe_secret_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
BACKEND_URL=https://your-ngrok-url.ngrok-free.dev
FRONTEND_URL=http://localhost
NODE_ENV=development

# MoMo Payment Gateway Configuration
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create


